# ============================================================
# Redz Restaurant — Environment Variables
# Set these in Vercel: Project Settings → Environment Variables
# ============================================================

# --- Site URL (REQUIRED on a custom domain) ---
# Drives sitemap.xml, robots.txt, and OpenGraph/canonical URLs.
# MUST be set to the production domain, e.g. https://redzrestaurant.com
# If unset, it falls back to https://redz-restaurant.vercel.app
NEXT_PUBLIC_SITE_URL="https://redzrestaurant.com"

# --- Supabase (REQUIRED — reservations, leads, admin CRM) ---
NEXT_PUBLIC_SUPABASE_URL="https://xtdutubocjaonocucuzs.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# --- OpenAI (REQUIRED — Henry AI Concierge text chat) ---
# Account must have billing/quota or chat returns "Henry is offline".
OPENAI_API_KEY="your_openai_api_key_here"

# --- Retell AI (voice concierge) ---
RETELL_API_KEY="your_retell_api_key_here"
# Agent id is now read server-side first; NEXT_PUBLIC_ kept as fallback.
RETELL_AGENT_ID="your_retell_agent_id_here"
NEXT_PUBLIC_RETELL_AGENT_ID="your_retell_agent_id_here"

# --- Resend (email confirmations — optional; skips if unset) ---
RESEND_API_KEY="your_resend_api_key_here"
FROM_EMAIL="reservations@yourdomain.com"   # must be a Resend-verified domain
RESTAURANT_EMAIL="info@redzrestaurant.com"

# --- Twilio (SMS confirmations — optional; skips if unset) ---
TWILIO_ACCOUNT_SID="your_twilio_sid"
TWILIO_AUTH_TOKEN="your_twilio_token"
TWILIO_PHONE_NUMBER="+1234567890"
RESTAURANT_PHONE_NUMBER="+1987654321"
