# ============================================================
# Redz Restaurant — Environment Variables
# Set these in Vercel: Project Settings → Environment Variables
# (Production scope), then redeploy.
# ============================================================

# --- Site URL (REQUIRED on a custom domain) ---
# Drives sitemap.xml, robots.txt, OpenGraph/canonical URLs, and Origin checks.
# MUST be the live domain, no trailing slash.
NEXT_PUBLIC_SITE_URL="https://redzrestaurant.com"

# --- Supabase (REQUIRED — reservations, leads, admin CRM) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# Optional: comma-separated staff emails allowed into /admin.
# If unset, any Supabase Auth user can access CRM (so disable public sign-up!).
NEXT_PUBLIC_ADMIN_EMAILS="owner@redzrestaurant.com"

# --- OpenRouter (REQUIRED — Henry AI Concierge text chat) ---
# Get a key: https://openrouter.ai/keys  — fund the balance or chat stays offline.
OPENROUTER_API_KEY="your_openrouter_api_key_here"
# Model must support tool calling. Prefer ids that exist on OpenRouter today.
# Examples: openai/gpt-4o-mini, anthropic/claude-haiku-4.5
CHAT_MODEL="openai/gpt-4o-mini"

# --- Resend (REQUIRED for guest/staff email confirmations) ---
# https://resend.com/api-keys — also verify your domain at https://resend.com/domains
RESEND_API_KEY="your_resend_api_key_here"
FROM_EMAIL="reservations@redzrestaurant.com"
RESTAURANT_EMAIL="info@redzrestaurant.com"

# --- Twilio (optional SMS confirmations — skips if unset) ---
TWILIO_ACCOUNT_SID="your_twilio_sid"
TWILIO_AUTH_TOKEN="your_twilio_token"
TWILIO_PHONE_NUMBER="+1234567890"
RESTAURANT_PHONE_NUMBER="+1987654321"
